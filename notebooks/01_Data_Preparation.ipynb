        "#Check that duplicate IDs have matching content\n",
        "duplicate_examples = con.execute(\"\"\"\n",
        "    SELECT *\n",
        "    FROM reviews_master\n",
        "    WHERE id IN (\n",
        "        SELECT id\n",
        "        FROM reviews_master\n",
        "        WHERE id IS NOT NULL\n",
        "        GROUP BY id\n",
        "        HAVING COUNT(*) > 1\n",
        "    )\n",
        "    ORDER BY id, location\n",
        "    LIMIT 30\n",
        "\"\"\").df()\n",
        "\n",
        "print(\"\\nDuplicate examples:\")\n",
        "display(duplicate_examples)"
      ],
