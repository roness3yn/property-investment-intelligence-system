    },
    {
      "cell_type": "markdown",
      "source": [
        "1. Listings:"
      ],
      "metadata": {
        "id": "4tSvyqdk9ie9"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "#Dictionary of locations\n",
        "location_country = {\n",
        "    \"Amsterdam\": \"Netherlands\",\n",
        "    \"Antwerp\": \"Belgium\",\n",
        "    \"Athens\": \"Greece\",\n",
