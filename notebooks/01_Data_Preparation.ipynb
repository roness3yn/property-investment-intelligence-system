        "    \"Brussels\": \"Belgium\",\n",
        "    \"Copenhagen\": \"Denmark\",\n",
        "    \"Crete\": \"Greece\",\n",
        "    \"Dublin\": \"Ireland\",\n",
        "    \"Edinburgh\": \"United Kingdom\",\n",
        "    \"Euskadi\": \"Spain\",\n",
        "    \"Florence\": \"Italy\",\n",
        "    \"Geneva\": \"Switzerland\",\n",
        "    \"Ghent\": \"Belgium\",\n",
        "    \"Girona\": \"Spain\",\n",
        "    \"Greater Manchester\": \"United Kingdom\",\n",
        "    \"Lisbon\": \"Portugal\",\n",
        "    \"London\": \"United Kingdom\",\n",
        "    \"Lyon\": \"France\",\n",
        "    \"Madrid\": \"Spain\",\n",
        "    \"Mallorca\": \"Spain\",\n",
        "    \"Menorca\": \"Spain\",\n",
        "    \"Milan\": \"Italy\",\n",
        "    \"Munich\": \"Germany\",\n",
        "    \"Naples\": \"Italy\",\n",
        "    \"Oslo\": \"Norway\",\n",
        "    \"Paris\": \"France\",\n",
        "    \"Porto\": \"Portugal\",\n",
        "    \"Prague\": \"Czech Republic\",\n",
        "    \"Puglia\": \"Italy\",\n",
        "    \"Riga\": \"Latvia\",\n",
        "    \"Rome\": \"Italy\",\n",
        "    \"Rotterdam\": \"Netherlands\",\n",
        "    \"Sevilla\": \"Spain\",\n",
        "    \"Sicily\": \"Italy\",\n",
        "    \"South Aegean\": \"Greece\",\n",
        "    \"The Hague\": \"Netherlands\",\n",
        "    \"Thessaloniki\": \"Greece\",\n",
        "    \"Valencia\": \"Spain\",\n",
        "    \"Vaud\": \"Switzerland\",\n",
        "    \"Venice\": \"Italy\",\n",
        "    \"Vienna\": \"Austria\"\n",
        "}\n"
      ],
      "metadata": {
        "id": "h6Ff_XB21JsX"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Function to combine CSV files to dataframes\n",
        "def combine_airbnb_files(folder_path, file_type):\n",
        "    folder = Path(folder_path)\n",
        "    # Detect files ending with _listings.csv or _reviews.csv\n",
        "    csv_files = sorted(folder.glob(f\"*_{file_type}.csv\"))\n",
        "    print(f\"\\nFound {len(csv_files)} {file_type} files.\")\n",
        "\n",
        "    if not csv_files:\n",
        "        raise FileNotFoundError(\n",
        "            f\"No matching CSV files found in {folder}\"\n",
        "        )\n",
        "\n",
        "    dataframes = []\n",
        "    file_summary = []\n",
        "\n",
        "    for file in csv_files:\n",
        "        # Extract location from filename\n",
        "        # Example: Greater_Manchester_listings.csv\n",
        "        # Result: Greater Manchester\n",
        "        location = (\n",
        "            file.stem\n",
        "            .removesuffix(f\"_{file_type}\")\n",
        "            .replace(\"_\", \" \")\n",
        "        )\n",
        "        country = location_country.get(location, \"Unknown\")\n",
        "\n",
        "        # Read file\n",
        "        df = pd.read_csv(\n",
        "            file,\n",
        "            low_memory=False\n",
        "        )\n",
        "\n",
        "        # Add geographic and source identifiers\n",
        "        df[\"location\"] = location\n",
        "        df[\"country\"] = country\n",
        "        df[\"source_file\"] = file.name\n",
        "\n",
        "        dataframes.append(df)\n",
        "\n",
        "        file_summary.append({\n",
        "            \"location\": location,\n",
        "            \"country\": country,\n",
        "            \"file\": file.name,\n",
        "            \"rows\": len(df),\n",
        "            \"columns\": len(df.columns)\n",
        "        })\n",
        "\n",
        "        print(\n",
        "            f\"Loaded {file.name}: \"\n",
        "            f\"{len(df):,} rows\"\n",
        "        )\n",
        "\n",
        "    # Concatenate all files vertically\n",
        "    master_df = pd.concat(\n",
        "        dataframes,\n",
        "        ignore_index=True,\n",
        "        sort=False\n",
        "    )\n",
        "\n",
        "    summary_df = pd.DataFrame(file_summary)\n",
        "\n",
        "    print(f\"\\n{file_type.upper()} MASTER CREATED\")\n",
        "    print(f\"Total rows: {len(master_df):,}\")\n",
        "    print(f\"Total columns: {master_df.shape[1]}\")\n",
        "    print(f\"Locations: {master_df['location'].nunique()}\")\n",
        "    print(f\"Countries: {master_df['country'].nunique()}\")\n",
        "\n",
        "    return master_df, summary_df"
      ],
      "metadata": {
        "id": "Gccz2H4t1U7f"
      },
      "execution_count": null,
      "outputs": []
    },
